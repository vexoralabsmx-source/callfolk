{
  "expo": {
    "name": "callfolk",
    "slug": "callfolk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "callfolk",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.callfolk.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Callfolk uses the camera to scan contact QR codes.",
        "NSMicrophoneUsageDescription": "Callfolk uses the microphone for voice calls and voice notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.callfolk.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Callfolk to scan contact QR codes."
        }
      ],
      "expo-audio",
      "expo-asset",
      "@livekit/react-native-expo-plugin"
    ]
  }
}
